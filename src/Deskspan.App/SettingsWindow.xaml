<Window x:Class="Deskspan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deskspan"
        Width="420"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Paper}"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,14,18,16">
      <StackPanel Orientation="Horizontal">
        <Path Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource Accent}" Margin="0,2,7,0" VerticalAlignment="Center"
              Data="M2,1 L14,9 L9,10 L12,16 L10,17 L7,11 L3,15 Z"/>
        <TextBlock Text="Deskspan" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="StatusText" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,3" TextWrapping="Wrap"/>
      <TextBlock x:Name="DetailText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="This computer" FontSize="12" Foreground="{StaticResource Muted}"/>
          <TextBox x:Name="NameBox" Margin="0,6,0,0" LostFocus="NameBox_LostFocus"/>
        </StackPanel>
      </Border>

      <Border x:Name="QuickRequestCard" Background="{StaticResource Accent}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="QuickRequestText" Foreground="{StaticResource AccentInk}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Allow" Style="{StaticResource PrimaryButton}" Width="120" Click="AllowQuick_Click"/>
            <Button Content="No" Style="{StaticResource QuietButton}" Margin="10,0,0,0" Click="DenyQuick_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="NearbyCard" Background="{StaticResource Card}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button x:Name="SearchButton" Content="Search" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Click="Search_Click"/>
            <TextBlock Text="On this Wi-Fi" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="NearbyHint" Text="Tap a computer to connect. It will ask them to allow it." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <StackPanel x:Name="NearbyPanel" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Border x:Name="ShareCard" Background="{StaticResource Card}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Share this computer" FontSize="12" Foreground="{StaticResource Muted}"/>
          <Button x:Name="CreateCodeButton" Content="Create a code" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="CreateCode_Click"/>
          <StackPanel x:Name="CodePanel" Visibility="Collapsed">
            <TextBlock x:Name="CodeText" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <Button x:Name="CancelCodeButton" Content="Cancel" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Margin="0,2,0,0" Click="CancelCode_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="EnterCodeCard" Background="{StaticResource Card}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Code from the other computer" FontSize="12" Foreground="{StaticResource Muted}"/>
          <TextBox x:Name="CodeBox" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" MaxLength="11" Margin="0,8,0,0" PreviewTextInput="CodeBox_PreviewTextInput"/>
          <Button x:Name="PairButton" Content="Connect" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="Pair_Click"/>
          <TextBlock x:Name="PairErrorText" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border x:Name="PairedCard" Background="{StaticResource Card}" CornerRadius="14" Padding="14,10" Margin="0,0,0,8" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="ForgetButton" Content="Unpair" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Click="Forget_Click"/>
          <TextBlock x:Name="PeerText" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>

      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Share" FontSize="12" Foreground="{StaticResource Muted}"/>
          <Button x:Name="ShareMouseButton" Content="Only mouse" Style="{StaticResource ChoiceButton}" Click="ShareMouse_Click"/>
          <Button x:Name="ShareKeyboardButton" Content="Only keyboard" Style="{StaticResource ChoiceButton}" Click="ShareKeyboard_Click"/>
          <Button x:Name="ShareBothButton" Content="Keyboard + mouse" Style="{StaticResource ChoiceButton}" Click="ShareBoth_Click"/>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Shortcut" FontSize="12" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="HotkeyText" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
          <TextBlock x:Name="HotkeyNote" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Button x:Name="ProLinkButton" Content="More PCs and custom shortcuts: Deskspan Pro" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="ProLink_Click"/>
    </StackPanel>
  </ScrollViewer>
</Window>

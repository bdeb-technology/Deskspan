<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Deskspan</RootNamespace>
    <AssemblyName>Deskspan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Description>Deskspan. Share one keyboard and mouse between two Windows PCs.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deskspan.Input\Deskspan.Input.csproj" />
    <ProjectReference Include="..\Deskspan.Net\Deskspan.Net.csproj" />
  </ItemGroup>
</Project>
